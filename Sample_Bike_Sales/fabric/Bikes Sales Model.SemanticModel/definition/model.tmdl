model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DirectLake - LH_Bikes"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","DaxQueryView_Desktop"]

ref table Customers
ref table Vendors
ref table 'Vendor Addresses'
ref table 'Customer Addresses'
ref table 'Sales Orders'
ref table 'Product Categories'
ref table 'Sales Order Items'
ref table Products
ref table 'Product Descriptions'
ref table 'Product Names'
ref table 'Product Category Names'
ref table 'Product Category Descriptions'

